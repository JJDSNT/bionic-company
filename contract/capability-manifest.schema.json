{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJDSNT/bionic-company/contract/capability-manifest.schema.json",
  "title": "Capability manifest",
  "description": "What a domain can achieve, published by the domain. Never how. Contract version 0.1.",
  "type": "object",
  "required": ["domain", "contract_version", "provides", "work_unit", "signals"],
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" } }
    },
    "contract_version": { "const": "0.1" },
    "provides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["capability"], "additionalProperties": false,
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "outcomes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "work_unit": {
      "type": "object", "required": ["kind", "ref_field"], "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "description": "What the domain calls its unit of work: book, production." },
        "ref_field": { "type": "string", "description": "Where the domain's own reference for it comes from." }
      }
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "signal.schema.json#/properties/type" }
    }
  }
}
